# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# =========================================================================
# ENVIRONMENT FILES  --  NEVER commit real secrets. .env.example is fine.
# =========================================================================
# Root, /backend, and /frontend .env variants are all excluded here so the
# Shopify tokens (SHOPIFY_ADMIN_TOKEN, SHOPIFY_STOREFRONT_TOKEN, etc.),
# Stripe / Brevo / R2 / Cloudflare / JWT secrets, and any *.env.production
# overrides never leak into git history \u2014 no matter which subdirectory they
# live in.

.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.env
*.env.*
!*.env.example
!.env.example

# Any other credential blobs
*token.json*
*credentials.json*
credentials.json
.credentials
*.pem
*.key

# =========================================================================
# IDE / editors
# =========================================================================
.idea/
.vscode/

# =========================================================================
# Node / JS dependencies + build output
# =========================================================================
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/
dist

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# =========================================================================
# System files
# =========================================================================
.DS_Store

# =========================================================================
# Python
# =========================================================================
__pycache__/
*pyc*
venv/
.venv/
.ruff_cache/

# =========================================================================
# Development tools / mixed
# =========================================================================
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel

# Data and databases
agenthub/agents/youtube/db

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

# Mobile development
android-sdk/
